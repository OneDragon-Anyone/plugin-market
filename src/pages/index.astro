---
import AppLayout from "@/layouts/AppLayout.astro";
import MarketApp from "@/components/app/MarketApp";
import { extractFluentStyles } from "@/lib/fluent-ssr";
import { getPlugins } from "@/lib/data";
import { pageTitle, siteConfig } from "@/lib/site";

const plugins = await getPlugins();
const islandStyles = extractFluentStyles(MarketApp, { plugins });
---

<AppLayout
  title={pageTitle("插件市场")}
  description={siteConfig.description}
  islandStyles={islandStyles}
>
  <MarketApp client:load plugins={plugins} />
</AppLayout>
