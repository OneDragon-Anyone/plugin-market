---
import AppLayout from "@/layouts/AppLayout.astro";
import PolicyApp from "@/components/app/PolicyApp";
import { extractFluentStyles } from "@/lib/fluent-ssr";
import { pageTitle, siteConfig } from "@/lib/site";

const islandStyles = extractFluentStyles(PolicyApp);
---

<AppLayout
  title={pageTitle("规范政策")}
  description={`${siteConfig.short} 插件的权限风险标签与分发状态规范。`}
  islandStyles={islandStyles}
>
  <PolicyApp client:load />
</AppLayout>
