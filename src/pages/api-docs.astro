---
import AppLayout from "@/layouts/AppLayout.astro";
import ApiDocsApp from "@/components/app/ApiDocsApp";
import { extractFluentStyles } from "@/lib/fluent-ssr";
import { pageTitle, siteConfig } from "@/lib/site";

const islandStyles = extractFluentStyles(ApiDocsApp);
---

<AppLayout
  title={pageTitle("API 接口")}
  description={`${siteConfig.short} 插件注册表的静态只读 JSON API。`}
  islandStyles={islandStyles}
>
  <ApiDocsApp client:load />
</AppLayout>
